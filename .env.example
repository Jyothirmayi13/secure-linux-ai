# Copy this file to .env and put your own key in it.
# .env is git-ignored and must never be committed — a pushed key is a key
# anyone can spend, and the bill and the abuse trail land on your account.
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=paste-your-own-key-here

# Optional: override the Gemini model name.
# AI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Which model answers at all. A policy.yaml 'ai:' section overrides these;
# if the two name different providers the run is refused rather than guessed.
# Check the resolved answer any time without sending anything:
#   python main.py --provider-show
# ---------------------------------------------------------------------------

# gemini | openai | ollama. Without this, a provider is detected from whichever
# of GEMINI_API_KEY or SSM_BASE_URL is present, and if neither is, nothing runs.
# SSM_PROVIDER=ollama

# Model name for the chosen provider.
# SSM_MODEL=qwen2.5-coder:7b

# Endpoint. Required for 'openai' when you are not using api.openai.com —
# LM Studio, llama.cpp, vLLM, Groq and Together all speak this protocol.
# Ollama defaults to http://127.0.0.1:11434/v1 and needs no key.
# SSM_BASE_URL=http://localhost:1234/v1

# Key for an OpenAI-compatible endpoint (SSM_API_KEY or OPENAI_API_KEY both work).
# A loopback endpoint is allowed to have none.
# SSM_API_KEY=paste-your-own-key-here
